{
  "name": "dhcw-prototype-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Create HTML prototypes of Digital Health and Care Wales services with the DHCW design system.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DHCW-Digital-Health-and-Care-Wales/dhcw-prototype-kit.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/kit/start.js",
    "start": "node src/kit/start.js",
    "example": "node --watch src/kit/start.js examples/question-journey",
    "test": "node --test \"specs/test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "allowScripts": {
    "@parcel/watcher": false
  },
  "dependencies": {
    "dhcw-design-system": "^0.1.105",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "nunjucks": "^3.2.4",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
